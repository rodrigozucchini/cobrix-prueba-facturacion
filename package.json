{
	"name": "cobrix-prueba-facturacion",
	"version": "1.0.0",
	"private": true,
	"description": "Prueba técnica: integrar Cobrix con la API de un administrador de facturas.",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "vite build",
		"prestart": "npm run build",
		"start": "node --disable-warning=ExperimentalWarning --import tsx src/main.ts",
		"start:isp": "node --disable-warning=ExperimentalWarning --import tsx src/main.ts isp",
		"start:cobrix": "npm run build && node --disable-warning=ExperimentalWarning --import tsx src/main.ts cobrix",
		"dev": "vite",
		"dev:api": "node --disable-warning=ExperimentalWarning --import tsx --watch src/main.ts",
		"seed": "node --disable-warning=ExperimentalWarning src/billing-api/seed.ts",
		"test": "node --disable-warning=ExperimentalWarning --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.panel.json"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/react-query": "5.104.2",
		"@types/node": "24.3.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "5.2.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lucide-react": "0.577.0",
		"radix-ui": "1.8.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-router": "7.18.4",
		"sonner": "2.0.8",
		"tailwind-merge": "3.7.0",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "5.9.2",
		"vite": "7.3.7"
	},
	"dependencies": {
		"@nestjs/common": "12.1.1",
		"@nestjs/core": "12.1.1",
		"@nestjs/platform-express": "12.1.1",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"tsx": "4.23.15"
	}
}
